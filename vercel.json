{
  "redirects": [
    {
      "source": "/template-editor",
      "destination": "https://studio.wristo.io/tokens",
      "permanent": true
    },
    {
      "source": "/tpl",
      "destination": "https://studio.wristo.io/tokens",
      "permanent": true
    },
    {
      "source": "/:lang/template-editor",
      "destination": "https://studio.wristo.io/tokens",
      "permanent": true
    },
    {
      "source": "/:lang/tpl",
      "destination": "https://studio.wristo.io/tokens",
      "permanent": true
    },
    {
      "source": "/product/:id",
      "destination": "/app/:id",
      "permanent": true
    },
    {
      "source": "/:lang/product/:id",
      "destination": "/:lang/app/:id",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/faq/:path*",
      "destination": "/support/:path*",
      "permanent": true
    },
    {
      "source": "/:lang/faq",
      "destination": "/:lang/support",
      "permanent": true
    },
    {
      "source": "/:lang/faq/:path*",
      "destination": "/:lang/support/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/collections/:slug(data-rich-garmin-watch-faces|analog-garmin-watch-faces|outdoor-garmin-watch-faces)",
      "destination": "/collections/:slug/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://api.wristo.io/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-Requested-With, Content-Type, Accept, Authorization"
        }
      ]
    },
    {
      "source": "/:private(auth|checkout|checkout-subscription|payment|auto-unlock|subscription-management|subscription-cancel|activate|purchases-history|user|email|preferences|unsubscribe|code|unlock|daily|newsletter)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/:lang(en|de|es|fr|it|pt-br|nl|pl|sv|da|cs|zh|ja|ko)/:private(auth|checkout|checkout-subscription|payment|auto-unlock|subscription-management|subscription-cancel|activate|purchases-history|user|email|preferences|unsubscribe|code|unlock|daily|newsletter)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/studio/membership",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "buildCommand": "npm run seo:browser:install && npm run build"
}
